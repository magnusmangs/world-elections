{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/frettir/:id",
      "destination": "/frettir"
    },
    {
      "source": "/brennidepill/:id",
      "destination": "/brennidepill"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/ask.js": {
      "includeFiles": "data/**",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/fjarmal",
      "destination": "/",
      "permanent": false
    }
  ]
}
